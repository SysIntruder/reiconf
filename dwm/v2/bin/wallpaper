#!/bin/sh

# dependencies
# - nsxiv     (for wallpaper selector)
# - hsetroot  (for wallpaper setter)

# use Q when exiting nsxiv so nsxiv can print current picture into stdout
file=$(nsxiv -o "$HOME/Pictures/backgrounds") || exit 1
[ -n "$file" ] || exit 0

mkdir -p "$HOME/.local/share/backgrounds" || exit 1
cp "$file" "$HOME/.local/share/backgrounds/wallpaper.png" || exit 1

hsetroot -cover "$HOME/.local/share/backgrounds/wallpaper.png"
